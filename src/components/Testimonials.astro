---
interface TestimonialItem {
	role: string;
	quote: string;
}

interface Props {
	heading?: string;
	items?: TestimonialItem[];
}

const { heading = '', items = [] } = Astro.props;
---

<section class="mx-auto max-w-5xl px-6 py-12 md:px-10 md:py-16">
	<h2 class="font-display mb-8 text-2xl text-paper md:text-3xl">{heading}</h2>
	<div class="grid grid-cols-1 gap-4 md:grid-cols-3">
		{
			items.map((item) => (
				<div class="flex flex-col gap-4 rounded-lg border border-line p-5 md:p-6">
					<span class="text-base tracking-wide text-accent uppercase">{item.role}</span>
					<p class="text-sm leading-relaxed text-paper-dim md:text-base">“{item.quote}”</p>
				</div>
			))
		}
	</div>
</section>
