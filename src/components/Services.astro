---
interface ServiceItem {
	number: string;
	title: string;
	body: string;
}

interface Props {
	label?: string;
	items?: ServiceItem[];
	howIWorkLabel?: string;
	howIWork?: string;
}

const { label = 'Services', items = [], howIWorkLabel = '', howIWork = '' } = Astro.props;
---

<section class="mx-auto max-w-5xl px-6 py-20 md:px-10 md:py-24">
	<p class="mb-8 text-xs tracking-[0.2em] text-accent-soft uppercase">{label}</p>
	<div class="divide-y divide-line border-t border-line">
		{
			items.map((item) => (
				<div class="grid gap-2 py-8 md:grid-cols-[auto_1fr] md:gap-10 md:py-10">
					<span class="font-display text-sm text-paper-dim md:text-base">{item.number}</span>
					<div>
						<h3 class="font-display text-lg text-paper md:text-xl">{item.title}</h3>
						<p class="mt-2 text-base leading-relaxed text-paper-dim md:text-lg">{item.body}</p>
					</div>
				</div>
			))
		}
	</div>
	{
		howIWork && (
			<p class="mt-10 border-t border-line pt-8 text-sm tracking-wide text-paper-dim md:text-base">
				<span class="text-paper">{howIWorkLabel}</span>｜{howIWork}
			</p>
		)
	}
</section>
