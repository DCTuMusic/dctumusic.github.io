---
interface ServiceItem {
	number: string;
	title: string;
	body: string;
}

interface Props {
	label?: string;
	items?: ServiceItem[];
	howIWorkLabel?: string;
	howIWork?: string;
}

const { label = 'Services', items = [], howIWorkLabel = '', howIWork = '' } = Astro.props;
---

<section class="mx-auto max-w-5xl px-6 py-20 md:px-10 md:py-20">
	<h2 class="font-display mb-8 text-2xl text-paper md:text-3xl">{label}</h2>
	<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
		{
			items.map((item) => (
				<div class="rounded-lg border border-line p-5 md:p-6">
					<span class="text-sm text-accent-soft">{item.number}</span>
					<h3 class="font-display mt-2 text-lg text-paper">{item.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-paper-dim">{item.body}</p>
				</div>
			))
		}
	</div>
	{
		howIWork && (
			<p class="mt-10 border-t border-line pt-8 text-sm tracking-wide text-paper-dim md:text-base">
				<span class="text-paper">{howIWorkLabel}</span>｜{howIWork}
			</p>
		)
	}
</section>
