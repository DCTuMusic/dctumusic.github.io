---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { translateTag } from '../data/tags';

const lang = Astro.currentLocale ?? 'en';

const allWork = await getCollection('portfolio');
const featured = allWork
	.filter((entry) => entry.data.featured)
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3);
---

<section class="mx-auto max-w-6xl px-6 py-8 md:px-10">
	<div class="grid grid-cols-3 gap-2 sm:gap-4 md:gap-8">
		{
			featured.map((entry) => {
				const displayTitle = (lang === 'zh-Hant' && entry.data.titleZh) || entry.data.title;
				return (
					<a
						href={getRelativeLocaleUrl(lang, `/portfolio/${entry.id}`)}
						class="group block overflow-hidden rounded-lg border border-line"
					>
						<div class="aspect-video overflow-hidden bg-ink-soft">
							<Image
								src={entry.data.cover}
								alt={displayTitle}
								class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
							/>
						</div>
						<div class="p-2 sm:p-4 md:p-5">
							<h3 class="font-display text-xs text-paper sm:text-sm md:text-base">{displayTitle}</h3>
							<p class="mt-1 hidden text-xs tracking-wide text-paper-dim uppercase sm:block">
								{entry.data.mediaType.map((tag) => translateTag(tag, lang)).join(' / ')}
							</p>
						</div>
					</a>
				);
			})
		}
	</div>
</section>
