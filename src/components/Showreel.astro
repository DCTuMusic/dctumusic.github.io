---
import { site } from '../data/site';
import { getEmbedStyle } from '../lib/embed';

const { showreelEmbed } = site;
---

<section class="pt-28">
	<div class="mx-auto max-w-6xl px-6 md:px-10">
		{
			showreelEmbed ? (
				<div
					class="embed-frame relative mx-auto max-w-full overflow-hidden rounded-lg border border-line bg-ink-soft"
					style={getEmbedStyle(showreelEmbed)}
				>
					<Fragment set:html={showreelEmbed} />
				</div>
			) : (
				<div class="flex aspect-video items-center justify-center rounded-lg border border-dashed border-line bg-ink-soft">
					<p class="px-6 text-center text-sm text-paper-dim">
						Showreel placeholder — paste the embed code in{' '}
						<code class="text-accent-soft">src/data/site.ts</code>
					</p>
				</div>
			)
		}
	</div>
</section>

<style>
	.embed-frame :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
</style>
