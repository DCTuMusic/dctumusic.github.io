---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';
import { useTranslations } from '../i18n/utils';

interface Props {
	images: ImageMetadata[];
	alt?: string;
	// Full-resolution src to open in the lightbox on click, one per image.
	lightboxSrcs: string[];
	// Unique per gallery instance on a page, so the lightbox knows which
	// photos belong together for prev/next navigation.
	groupId: string;
	// Optional pre-formatted credit line, e.g. "Photo: Jane Doe" — rendered
	// on the opposite side of the scroll hint so the two sit symmetrically.
	credit?: string;
}

const { images, alt = '', lightboxSrcs, groupId, credit } = Astro.props;
const lang = (Astro.currentLocale ?? 'en') as 'en' | 'zh-Hant';
const t = useTranslations(lang);
const loop = images.length > 1;
// Three copies back-to-back create the illusion of infinite scroll — see
// the script below for how the middle copy is kept in view.
const reel = loop ? [...images, ...images, ...images] : images;
---

<div class="motion-gallery">
	<div class="viewport" data-loop={loop ? 'true' : 'false'}>
		<div class="strip flex h-56 w-max sm:h-64 md:h-72">
			{
				reel.map((image, i) => {
					const realIndex = i % images.length;
					return (
						<button
							type="button"
							class="thumb lightbox-trigger h-full flex-none cursor-pointer"
							data-lightbox-group={groupId}
							data-lightbox-src={lightboxSrcs[realIndex]}
							data-lightbox-alt={alt}
						>
							<Image
								src={image}
								alt=""
								class="h-full w-auto object-cover"
								draggable={false}
							/>
						</button>
					);
				})
			}
		</div>
		{
			loop && (
				<>
					<button type="button" class="nav prev" aria-label="Previous photo">
						‹
					</button>
					<button type="button" class="nav next" aria-label="Next photo">
						›
					</button>
				</>
			)
		}
	</div>
	{
		(loop || credit) && (
			<div class="caption-row">
				{loop && <p class="hint">{t('gallery.scrollHint')}</p>}
				{credit && (
					<p class="credit">
						{t('art.photoCredit')}
						{lang === 'zh-Hant' ? '：' : ': '}
						{credit}
					</p>
				)}
			</div>
		)
	}
</div>

<style>
	.motion-gallery {
		position: relative;
	}

	.viewport {
		overflow-x: auto;
		overflow-y: hidden;
		scrollbar-width: none;
		cursor: grab;
	}

	.viewport::-webkit-scrollbar {
		display: none;
	}

	.viewport.dragging {
		cursor: grabbing;
	}

	.strip {
		gap: 4px;
	}

	.thumb {
		border: none;
		background: none;
		padding: 0;
	}

	.nav {
		position: absolute;
		top: 50%;
		translate: 0 -50%;
		display: flex;
		height: 2.5rem;
		width: 2.5rem;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		border: 1px solid var(--color-line);
		background: color-mix(in srgb, var(--color-ink) 70%, transparent);
		color: var(--color-paper);
		font-size: 1.25rem;
		line-height: 1;
		opacity: 0;
		/* Deliberately always interactive, not toggled with visibility.
		   If this only became clickable once `.nav-visible` was added, a
		   mouse already resting on that spot when it appears wouldn't get
		   a real mouseenter — browsers don't retroactively fire hover
		   events just because pointer-events flipped under a motionless
		   cursor. Keeping it always-on means real hover tracking works
		   regardless of when the fade-in happens. The footprint is a
		   small fixed circle at the very edge, so this is a fine trade. */
		transition: opacity 0.3s ease;
		z-index: 2;
	}

	.motion-gallery.nav-visible .nav {
		opacity: 1;
	}

	.nav.prev {
		left: 0.75rem;
	}

	.nav.next {
		right: 0.75rem;
	}

	.caption-row {
		margin-top: 0.5rem;
		display: flex;
		align-items: baseline;
	}

	.hint {
		font-size: 0.75rem;
		color: var(--color-paper-dim);
	}

	.credit {
		margin-left: auto;
		font-size: 0.75rem;
		color: var(--color-paper-dim);
	}
</style>

<script>
	const DRAG_CLICK_THRESHOLD = 6; // px

	const NAV_IDLE_MS = 1500;

	document.querySelectorAll<HTMLElement>('.motion-gallery').forEach((gallery) => {
		const viewport = gallery.querySelector<HTMLElement>('.viewport');
		const strip = gallery.querySelector<HTMLElement>('.strip');
		const prevBtn = gallery.querySelector<HTMLElement>('.nav.prev');
		const nextBtn = gallery.querySelector<HTMLElement>('.nav.next');
		if (!viewport || !strip) return;

		const loop = viewport.dataset.loop === 'true';

		let oneSetWidth = 0;
		let dragging = false;
		let moved = false;
		let startX = 0;
		let startScrollLeft = 0;
		let lastX = 0;
		let lastTime = 0;
		let velocity = 0;
		let momentumFrame = 0;

		function measure() {
			oneSetWidth = strip!.scrollWidth / 3;
			if (loop) viewport!.scrollLeft = oneSetWidth;
		}

		function wrap() {
			if (!loop || oneSetWidth === 0) return;
			if (viewport!.scrollLeft < oneSetWidth * 0.5) {
				viewport!.scrollLeft += oneSetWidth;
			} else if (viewport!.scrollLeft > oneSetWidth * 1.5) {
				viewport!.scrollLeft -= oneSetWidth;
			}
		}

		let navAnimFrame = 0;

		// Hand-rolled instead of viewport.scrollBy({behavior:'smooth'}) —
		// the native smooth-scroll animation and wrap()'s mid-flight
		// scrollLeft jump fight each other (the animation doesn't know its
		// target just moved), which is what caused the gallery to lock up
		// after a few arrow clicks. Driving scrollLeft ourselves lets us
		// shift the animation's own base position by the same amount
		// whenever wrap() fires, so the two stay in sync.
		function animateScrollBy(delta: number) {
			cancelAnimationFrame(navAnimFrame);
			let base = viewport!.scrollLeft;
			const duration = 400;
			const startTime = performance.now();

			function step(now: number) {
				const t = Math.min((now - startTime) / duration, 1);
				const eased = 1 - Math.pow(1 - t, 3);
				viewport!.scrollLeft = base + delta * eased;

				const before = viewport!.scrollLeft;
				wrap();
				const correction = viewport!.scrollLeft - before;
				if (correction !== 0) base += correction;

				if (t < 1) navAnimFrame = requestAnimationFrame(step);
			}

			navAnimFrame = requestAnimationFrame(step);
		}

		if (prevBtn && nextBtn) {
			let hideTimer = 0;

			// Ask the browser directly instead of maintaining our own
			// enter/leave-tracked boolean — :hover is always the current,
			// authoritative answer, so there's no risk of our bookkeeping
			// drifting out of sync with an actually-missed event.
			const isHoveringNav = () => prevBtn.matches(':hover') || nextBtn.matches(':hover');

			const tryHide = () => {
				if (isHoveringNav()) {
					hideTimer = window.setTimeout(tryHide, NAV_IDLE_MS);
					return;
				}
				gallery.classList.remove('nav-visible');
			};

			const showNav = () => {
				gallery.classList.add('nav-visible');
				window.clearTimeout(hideTimer);
				hideTimer = window.setTimeout(tryHide, NAV_IDLE_MS);
			};
			const hideNav = () => {
				gallery.classList.remove('nav-visible');
				window.clearTimeout(hideTimer);
			};
			gallery.addEventListener('mouseenter', showNav);
			gallery.addEventListener('mousemove', showNav);
			gallery.addEventListener('mouseleave', hideNav);

			// Leaving an arrow (but staying within the gallery) restarts the
			// idle countdown rather than waiting for the next mousemove
			// elsewhere in the gallery.
			[prevBtn, nextBtn].forEach((btn) => {
				btn.addEventListener('mouseleave', showNav);
			});

			prevBtn.addEventListener('click', () => {
				showNav();
				animateScrollBy(-viewport!.clientWidth * 0.8);
			});
			nextBtn.addEventListener('click', () => {
				showNav();
				animateScrollBy(viewport!.clientWidth * 0.8);
			});
		}

		function onPointerDown(e: PointerEvent) {
			// Deliberately no setPointerCapture here — capturing on the
			// scrollable container breaks the browser's native click-event
			// synthesis on the buttons inside it, which silently kills
			// click-to-open-lightbox. Plain document-level listeners below
			// give the same drag tracking without that side effect.
			dragging = true;
			moved = false;
			startX = e.clientX;
			lastX = e.clientX;
			startScrollLeft = viewport!.scrollLeft;
			lastTime = performance.now();
			velocity = 0;
			cancelAnimationFrame(momentumFrame);
			viewport!.classList.add('dragging');
			document.addEventListener('pointermove', onPointerMove);
			document.addEventListener('pointerup', onPointerUp);
			document.addEventListener('pointercancel', onPointerUp);
		}

		function onPointerMove(e: PointerEvent) {
			if (!dragging) return;
			const dx = e.clientX - startX;
			if (Math.abs(dx) > DRAG_CLICK_THRESHOLD) moved = true;

			const now = performance.now();
			const dt = Math.max(now - lastTime, 1);
			velocity = (e.clientX - lastX) / dt;
			lastX = e.clientX;
			lastTime = now;

			viewport!.scrollLeft = startScrollLeft - dx;
		}

		function onPointerUp() {
			if (!dragging) return;
			dragging = false;
			viewport!.classList.remove('dragging');
			document.removeEventListener('pointermove', onPointerMove);
			document.removeEventListener('pointerup', onPointerUp);
			document.removeEventListener('pointercancel', onPointerUp);

			let v = velocity;
			function momentum() {
				if (Math.abs(v) < 0.02) return;
				viewport!.scrollLeft -= v * 16;
				wrap();
				v *= 0.94;
				momentumFrame = requestAnimationFrame(momentum);
			}
			momentum();
		}

		viewport.addEventListener('pointerdown', onPointerDown);
		viewport.addEventListener('scroll', wrap);

		viewport.querySelectorAll('.thumb').forEach((thumb) => {
			thumb.addEventListener(
				'click',
				(e) => {
					if (moved) {
						e.preventDefault();
						e.stopPropagation();
					}
				},
				true,
			);
		});

		window.addEventListener('resize', measure);
		requestAnimationFrame(measure);
	});
</script>
