---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';
import { useTranslations } from '../i18n/utils';
import { clients } from '../data/clients';

const lang = (Astro.currentLocale ?? 'en') as 'en' | 'zh-Hant';
const t = useTranslations(lang);

const logoFiles = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/Client/*.{png,jpg,jpeg,svg,webp}',
	{ eager: true },
);

const logos = clients
	.map((client) => {
		const match = Object.entries(logoFiles).find(([path]) => path.endsWith(`/${client.file}`));
		return match ? { src: match[1].default, name: client.name } : null;
	})
	.filter((logo) => logo !== null);
---

<section class="mx-auto max-w-5xl px-6 py-12 md:px-10">
	<h2 class="font-display mb-8 text-2xl text-paper md:text-3xl">{t('clients.heading')}</h2>
	<div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4 md:gap-x-12 md:gap-y-12">
		{
			logos.map((logo) => (
				<div class="flex items-center justify-center">
					<Image src={logo!.src} alt={logo!.name} class="h-auto w-full max-w-[160px] object-contain" />
				</div>
			))
		}
	</div>
</section>
