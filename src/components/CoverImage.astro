---
// A cover image that can swap to a different picture on phone-sized screens.
// Without `mobileSrc` it renders exactly like a plain <Image>.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	mobileSrc?: ImageMetadata;
	alt: string;
	class?: string;
	style?: string;
}

const { src, mobileSrc, alt, class: className, style } = Astro.props;
const mobile = mobileSrc ? await getImage({ src: mobileSrc, width: 900 }) : null;
---

{
	mobile ? (
		<picture class="contents">
			{/* Phone-sized: below Tailwind's `sm` breakpoint (640px). */}
			<source
				media="(max-width: 639px)"
				srcset={mobile.src}
				width={mobile.attributes.width}
				height={mobile.attributes.height}
			/>
			<Image src={src} alt={alt} class={className} style={style} />
		</picture>
	) : (
		<Image src={src} alt={alt} class={className} style={style} />
	)
}
