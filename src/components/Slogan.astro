---
interface Props {
	text?: string;
}

const { text = '' } = Astro.props;
const [heading, ...body] = text.split('\n').filter(Boolean);
---

{
	text && (
		<section class="mx-auto max-w-3xl px-6 py-20 text-center md:px-10 md:py-24">
			<p class="font-display text-2xl leading-snug text-paper sm:text-3xl md:text-4xl">{heading}</p>
			{
				body.length > 0 && (
					<div class="mt-6 space-y-2 text-base leading-relaxed text-paper-dim md:text-lg">
						{body.map((line) => (
							<p>{line}</p>
						))}
					</div>
				)
			}
		</section>
	)
}
