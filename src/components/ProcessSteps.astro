---
interface ProcessItem {
	number: string;
	title: string;
	body: string;
}

interface Props {
	heading?: string;
	items?: ProcessItem[];
}

const { heading = '', items = [] } = Astro.props;
---

<section class="mx-auto max-w-5xl px-6 pt-10 pb-10 md:px-10 md:pt-10 md:pb-24">
	<h2 class="font-display mb-6 text-2xl text-paper md:text-3xl">{heading}</h2>
	<div class="grid grid-cols-1 gap-4 border-t border-line pt-8 sm:grid-cols-2 sm:gap-8 md:grid-cols-4 md:gap-8">
		{
			items.map((item, i) => (
				<>
					{i > 0 && (
						<div class="-my-1 flex justify-center text-sm leading-none text-accent-soft sm:hidden" aria-hidden="true">
							↓
						</div>
					)}
					<div>
						<span class="font-display text-xl text-accent-soft md:text-2xl">{item.number}</span>
						<h3 class="font-display mt-2 text-lg text-paper">{item.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-paper-dim">{item.body}</p>
					</div>
				</>
			))
		}
	</div>
</section>
