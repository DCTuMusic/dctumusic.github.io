---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

interface Props {
	text?: string | string[];
	photo?: ImageMetadata;
}

const { text = '', photo } = Astro.props;
const paragraphs = Array.isArray(text) ? text.filter(Boolean) : text ? [text] : [];
---

<section id="about" class="mx-auto max-w-5xl scroll-mt-24 px-6 py-20 md:px-10 md:py-24">
	<p class="mb-8 text-xs tracking-[0.2em] text-accent-soft uppercase">About</p>
	<div class="grid gap-10 sm:grid-cols-[minmax(0,300px)_1fr] sm:items-center sm:gap-16">
		<div class="aspect-[4/3] overflow-hidden rounded-lg bg-ink-soft sm:aspect-[3/4]">
			{
				photo ? (
					<Image src={photo} alt="DC" class="h-full w-full object-cover" />
				) : (
					<div class="flex h-full items-center justify-center border border-dashed border-line px-4 text-center text-sm text-paper-dim">
						Photo placeholder — drop an image in src/assets/about/
					</div>
				)
			}
		</div>
		<div>
			{
				paragraphs.length > 0 ? (
					<div class="space-y-4">
						{paragraphs.map((paragraph) => (
							<p class="text-lg leading-relaxed md:text-xl">{paragraph}</p>
						))}
					</div>
				) : (
					<p class="border border-dashed border-line px-6  text-lg text-paper-dim">
						Bio placeholder — add copy in this section's props
					</p>
				)
			}
		</div>
	</div>
</section>
