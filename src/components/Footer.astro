---
import { site } from '../data/site';

const year = new Date().getFullYear();
const { socials } = site;
---

<footer>
	<div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-6 py-16 text-center md:px-10">
		<div class="flex items-center gap-6 text-paper-dim">
			<a
				href={socials.instagram}
				aria-label="Instagram"
				class="transition-colors hover:text-accent-soft"
			>
				<svg
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
				>
					<rect x="3" y="3" width="18" height="18" rx="5" />
					<circle cx="12" cy="12" r="4.2" />
					<circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
				</svg>
			</a>
			<a href={socials.facebook} aria-label="Facebook" class="transition-colors hover:text-accent-soft">
				<svg width="20" height="20" viewBox="-337 273 123.5 256" fill="currentColor">
					<path
						d="M-260.9,327.8c0-10.3,9.2-14,19.5-14c10.3,0,21.3,3.2,21.3,3.2l6.6-39.2c0,0-14-4.8-47.4-4.8c-20.5,0-32.4,7.8-41.1,19.3 c-8.2,10.9-8.5,28.4-8.5,39.7v25.7H-337V396h26.5v133h49.6V396h39.3l2.9-38.3h-42.2V327.8z"
					/>
				</svg>
			</a>
			<a
				href={socials.soundcloud}
				aria-label="SoundCloud"
				class="transition-colors hover:text-accent-soft"
			>
				<svg
					width="22"
					height="22"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
				>
					<path
						d="M8 17h9.5a3.5 3.5 0 0 0 .5-6.96 5 5 0 0 0-9.6-1.44A4 4 0 0 0 8 17Z"
					/>
					<path d="M5.5 12v5M3.5 13.5v3.5" stroke-linecap="round" />
				</svg>
			</a>
		</div>

		<p class="text-sm text-paper-dim">Copyright DC {year}</p>
	</div>
</footer>
