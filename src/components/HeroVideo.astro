---
interface Props {
	heading?: string;
	subtext?: string;
}

const { heading = '', subtext = '' } = Astro.props;
---

<section class="hero-video relative h-screen w-full overflow-hidden bg-ink-soft">
	<video class="h-full w-full object-cover" autoplay muted loop playsinline>
		<source src={`${import.meta.env.BASE_URL}videos/hero-reel.mp4`} type="video/mp4" />
	</video>

	{
		heading && (
			<div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/70 via-ink/10 to-transparent pt-40 pb-20 md:top-0 md:bottom-auto md:bg-gradient-to-b md:pt-32">
				<div class="px-6 md:px-10">
					<h1 class="font-display max-w-4xl text-4xl leading-[1.05] tracking-tight text-paper sm:text-5xl md:text-6xl lg:text-7xl">
						{heading}
					</h1>
					{subtext && (
						<p class="mt-6 max-w-2xl text-lg leading-relaxed text-paper-dim md:text-xl">{subtext}</p>
					)}
				</div>
			</div>
		)
	}

	<button
		type="button"
		class="mute-toggle absolute right-6 bottom-6 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-ink/50 text-paper backdrop-blur-sm transition-colors hover:text-accent-soft md:right-10 md:bottom-10"
		aria-label="Unmute video"
		aria-pressed="false"
	>
		<svg class="icon-muted" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
			<path d="M4 9v6h4l5 5V4L8 9H4Z" />
			<path d="m17 9 4 6M21 9l-4 6" />
		</svg>
		<svg class="icon-unmuted hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
			<path d="M4 9v6h4l5 5V4L8 9H4Z" />
			<path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a9 9 0 0 1 0 12" />
		</svg>
	</button>
</section>

<script>
	document.querySelectorAll<HTMLElement>('.hero-video').forEach((hero) => {
		const video = hero.querySelector('video');
		const toggle = hero.querySelector<HTMLButtonElement>('.mute-toggle');
		const mutedIcon = hero.querySelector('.icon-muted');
		const unmutedIcon = hero.querySelector('.icon-unmuted');
		if (!video || !toggle) return;

		toggle.addEventListener('click', () => {
			video.muted = !video.muted;
			const isMuted = video.muted;
			toggle.setAttribute('aria-label', isMuted ? 'Unmute video' : 'Mute video');
			toggle.setAttribute('aria-pressed', String(!isMuted));
			mutedIcon?.classList.toggle('hidden', !isMuted);
			unmutedIcon?.classList.toggle('hidden', isMuted);
		});

		// Volume follows how far the hero has scrolled past: full volume for
		// the first 40%, an exponential decay through 40–70%, silent past 70%.
		// Reversible — it's recomputed from scroll position, not a one-way animation.
		const fadeStart = 0.4;
		const fadeEnd = 0.7;
		const decaySteepness = 4;
		function calcVolume(fractionPast: number) {
			if (fractionPast <= fadeStart) return 1;
			if (fractionPast >= fadeEnd) return 0;
			const p = (fractionPast - fadeStart) / (fadeEnd - fadeStart);
			const k = decaySteepness;
			return (Math.exp(-k * p) - Math.exp(-k)) / (1 - Math.exp(-k));
		}

		let ticking = false;
		function updateVolume() {
			const rect = hero.getBoundingClientRect();
			const scrolledPast = Math.min(Math.max(-rect.top, 0), rect.height);
			const fractionPast = rect.height > 0 ? scrolledPast / rect.height : 0;
			video.volume = calcVolume(fractionPast);
			ticking = false;
		}
		function onScroll() {
			if (!ticking) {
				requestAnimationFrame(updateVolume);
				ticking = true;
			}
		}
		window.addEventListener('scroll', onScroll, { passive: true });
		updateVolume();
	});
</script>
