---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { translateTag } from '../../data/tags';
import { useTranslations } from '../../i18n/utils';

const lang = (Astro.currentLocale ?? 'en') as 'en' | 'zh-Hant';
const t = useTranslations(lang);

const allWork = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);

const mediaTypes = [...new Set(allWork.flatMap((entry) => entry.data.mediaType))].sort();
const musicGenres = [...new Set(allWork.flatMap((entry) => entry.data.musicGenre))].sort();
---

<Layout title="Portfolio — Yen-Hao Tu">
	<main class="pt-28">
		<div class="mx-auto max-w-[90rem] px-6 md:px-10">
			<h1 class="font-display mb-10 text-3xl text-paper sm:text-4xl">{t('portfolio.heading')}</h1>

			<div class="mb-2 flex flex-wrap gap-3">
				<button
					type="button"
					data-filter-toggle="mediaType"
					class="filter-toggle flex items-center gap-2 rounded-full border border-line px-4 py-2 text-sm text-paper transition-colors hover:border-accent-soft"
				>
					{t('portfolio.filterMedia')} <span class="chevron">⌄</span>
				</button>
				<button
					type="button"
					data-filter-toggle="musicGenre"
					class="filter-toggle flex items-center gap-2 rounded-full border border-line px-4 py-2 text-sm text-paper transition-colors hover:border-accent-soft"
				>
					{t('portfolio.filterGenre')} <span class="chevron">⌄</span>
				</button>
				<button
					type="button"
					id="clear-filters"
					class="hidden rounded-full border border-line px-4 py-2 text-sm text-paper-dim transition-colors hover:border-accent-soft hover:text-paper"
				>
					{t('portfolio.clearFilters')}
				</button>
			</div>

			<div id="panel-mediaType" class="filter-panel hidden flex-wrap gap-2 py-4">
				{
					mediaTypes.map((value) => (
						<button
							type="button"
							class="pill rounded-full border border-line px-4 py-1.5 text-sm text-paper-dim transition-colors hover:border-accent-soft"
							data-axis="mediaType"
							data-value={value}
						>
							{translateTag(value, lang)}
						</button>
					))
				}
			</div>
			<div id="panel-musicGenre" class="filter-panel hidden flex-wrap gap-2 py-4">
				{
					musicGenres.map((value) => (
						<button
							type="button"
							class="pill rounded-full border border-line px-4 py-1.5 text-sm text-paper-dim transition-colors hover:border-accent-soft"
							data-axis="musicGenre"
							data-value={value}
						>
							{translateTag(value, lang)}
						</button>
					))
				}
			</div>

			<p id="empty-state" class="hidden py-16 text-center text-paper-dim">
				{t('portfolio.empty')}
			</p>

			<div id="work-grid" class="columns-1 gap-3 py-10 sm:columns-2 md:columns-3 lg:columns-4 ">
				{
					allWork.map((entry) => {
						const displayTitle = (lang === 'zh-Hant' && entry.data.titleZh) || entry.data.title;
						return (
							<a
								href={getRelativeLocaleUrl(lang, `/portfolio/${entry.id}`)}
								class="work-card group mb-4.5 block break-inside-avoid overflow-hidden rounded-lg"
								data-media={entry.data.mediaType.join(',')}
								data-genre={entry.data.musicGenre.join(',')}
							>
								<Image
									src={entry.data.cover}
									alt={displayTitle}
									class="w-full transition-[filter] transition-transform duration-500 group-hover:brightness-90 group-hover:scale-105"
								/>
								<div class="p-2.5">
									<h2 class="font-display text-base text-paper transition-colors  transition-transform duration-500 group-hover:text-accent group-hover:scale-105">
										{displayTitle}
									</h2>
									<p class="mt-1 text-xs tracking-wide text-paper-dim  transition-transform duration-500 group-hover:scale-105">
										{entry.data.mediaType.map((tag) => translateTag(tag, lang)).join(' / ')}
									</p>
								</div>
							</a>
						);
					})
				}
			</div>
		</div>
	</main>
</Layout>

<script>
	const toggles = document.querySelectorAll<HTMLButtonElement>('[data-filter-toggle]');
	const panels = document.querySelectorAll<HTMLDivElement>('.filter-panel');
	const pills = document.querySelectorAll<HTMLButtonElement>('.pill');
	const cards = document.querySelectorAll<HTMLAnchorElement>('.work-card');
	const clearButton = document.getElementById('clear-filters');
	const emptyState = document.getElementById('empty-state');
	const grid = document.getElementById('work-grid');

	const active: Record<string, Set<string>> = {
		mediaType: new Set(),
		musicGenre: new Set(),
	};

	toggles.forEach((toggle) => {
		toggle.addEventListener('click', () => {
			const axis = toggle.dataset.filterToggle!;
			const panel = document.getElementById(`panel-${axis}`);
			const isOpen = panel?.classList.contains('flex');

			panels.forEach((p) => {
				p.classList.add('hidden');
				p.classList.remove('flex');
			});
			toggles.forEach((t) => t.classList.remove('text-accent-soft'));

			if (!isOpen) {
				panel?.classList.remove('hidden');
				panel?.classList.add('flex');
				toggle.classList.add('text-accent-soft');
			}
		});
	});

	pills.forEach((pill) => {
		pill.addEventListener('click', () => {
			const axis = pill.dataset.axis!;
			const value = pill.dataset.value!;

			if (active[axis].has(value)) {
				active[axis].delete(value);
				pill.classList.remove('bg-paper', 'text-ink', 'border-paper');
			} else {
				active[axis].add(value);
				pill.classList.add('bg-paper', 'text-ink', 'border-paper');
			}

			applyFilters();
		});
	});

	function applyFilters() {
		const hasAnyFilter = Object.values(active).some((set) => set.size > 0);
		clearButton?.classList.toggle('hidden', !hasAnyFilter);

		let visibleCount = 0;

		cards.forEach((card) => {
			const media = card.dataset.media?.split(',') ?? [];
			const genre = card.dataset.genre?.split(',') ?? [];

			const mediaMatch = active.mediaType.size === 0 || media.some((m) => active.mediaType.has(m));
			const genreMatch = active.musicGenre.size === 0 || genre.some((g) => active.musicGenre.has(g));

			const visible = mediaMatch && genreMatch;
			card.classList.toggle('hidden', !visible);
			if (visible) visibleCount += 1;
		});

		emptyState?.classList.toggle('hidden', visibleCount > 0);
		grid?.classList.toggle('hidden', visibleCount === 0);
	}

	clearButton?.addEventListener('click', () => {
		active.mediaType.clear();
		active.musicGenre.clear();
		pills.forEach((pill) => pill.classList.remove('bg-paper', 'text-ink', 'border-paper'));
		applyFilters();
	});
</script>
