---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';
import { useTranslations } from '../../i18n/utils';

const lang = (Astro.currentLocale ?? 'en') as 'en' | 'zh-Hant';
const t = useTranslations(lang);
const email = site.email;
---

<Layout title="Contact — DC">
	<main class="flex min-h-[70vh] items-center pt-28">
		<div class="mx-auto max-w-2xl px-6 text-center md:px-10">
			<p class="mb-4 text-xs tracking-[0.2em] text-accent-soft uppercase">{t('contact.label')}</p>
			<h1 class="font-display text-3xl text-paper sm:text-4xl">
				{t('contact.heading1')}<br />{t('contact.heading2')}
			</h1>
			<p class="mx-auto mt-6 max-w-md text-paper-dim">
				{t('contact.subtext')}
			</p>
			<a
				href={`mailto:${email}`}
				class="mt-10 inline-block rounded-full bg-accent px-8 py-4 text-sm font-medium text-paper transition-transform hover:scale-105"
			>
				{email}
			</a>
		</div>
	</main>
</Layout>
