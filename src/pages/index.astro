---
import Layout from '../layouts/Layout.astro';
import HeroVideo from '../components/HeroVideo.astro';
import Showreel from '../components/Showreel.astro';
import Slogan from '../components/Slogan.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import AboutBlurb from '../components/AboutBlurb.astro';
import ClientLogos from '../components/ClientLogos.astro';
import Services from '../components/Services.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Testimonials from '../components/Testimonials.astro';
import { homepageCopy } from '../data/homepage';
import { bioCopy } from '../data/bio';
import { servicesCopy } from '../data/services';
import { processCopy } from '../data/process';
import type { ImageMetadata } from 'astro:assets';

const lang = (Astro.currentLocale ?? 'en') as keyof typeof homepageCopy;
const copy = homepageCopy[lang];
const bio = bioCopy[lang];
const services = servicesCopy[lang];
const workProcess = processCopy[lang];

// Drop one photo into src/assets/about/ (any filename) and it shows up here.
const aboutPhotos = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/about/*.{jpeg,jpg,png,webp,JPEG,JPG,PNG,WEBP,Jpeg,Jpg,Png,Webp}',
	{ eager: true },
);
const aboutPhoto = Object.values(aboutPhotos)[0]?.default;
---

<Layout hasHero>
	<main>
		<HeroVideo heading={copy.heroTagline.heading} subtext={copy.heroTagline.subtext} />
		<div id="hero-boundary" aria-hidden="true"></div>
		<Showreel />
		<Slogan text={copy.slogan1} />
		<FeaturedWork />
		<Slogan text={copy.slogan2} />
		<AboutBlurb text={bio} photo={aboutPhoto} />
		<ClientLogos />
		<Services
			label={services.label}
			items={services.items}
			howIWorkLabel={services.howIWorkLabel}
			howIWork={services.howIWork}
		/>
		<ProcessSteps heading={workProcess.heading} items={workProcess.items} />
		<Testimonials heading={copy.testimonials.heading} items={copy.testimonials.items} />
		<Slogan text={copy.slogan3} />
	</main>
</Layout>
